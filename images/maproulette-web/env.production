# Placeholders, replaced at container start by 40-maproulette-env.sh.
# Do not use placeholders for feature flags: the build can fold them into constants.
REACT_APP_BASE_PATH='/'
REACT_APP_URL='__MR_URL__'
REACT_APP_MAP_ROULETTE_SERVER_URL='__MR_URL__'
REACT_APP_MAP_ROULETTE_SERVER_WEBSOCKET_URL='__MR_WS_URL__'
REACT_APP_SERVER_OAUTH_URL='__MR_URL__/auth/authenticate?redirect=__MR_URL__'
REACT_APP_OSM_SERVER='__MR_OSM_SERVER__'
REACT_APP_OSM_API_SERVER='__MR_OSM_API_SERVER__'

REACT_APP_FEATURE_BOUNDED_TASK_BROWSING='enabled'
REACT_APP_FEATURE_LEADERBOARD='enabled'
REACT_APP_FEATURE_CHALLENGE_ANALYSIS_TABLE='enabled'
REACT_APP_FEATURE_MOBILE_DEVICES='enabled'
